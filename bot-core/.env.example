# ============ Servicio con VARIOS proyectos (rutas /mastertech/... y /citas/...) ============
BOT_PROJECTS=mastertech,citas

# --- Compartido (Gemini y BD) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
# BD comun: el bot usa su esquema "bot" y separa a los proyectos por project_id.
# Si un proyecto usa OTRA base, ponle <PROYECTO>_DATABASE_URL (ej. CITAS_DATABASE_URL).
BOT_DATABASE_URL=postgresql://USUARIO:PASSWORD@HOST:5432/postgres
BOT_POOL_MAX=3                  # conexiones por proyecto
BOT_RATE_LIMIT_PER_MIN=12
BOT_HISTORY_MESSAGES=16
BOT_RESUME_DAYS=30

# --- Master Tech ---
MASTERTECH_JWT_SECRET=          # igual al JWT_SECRET de su Spring (min. 32 caracteres)
MASTERTECH_API_URL=http://localhost:8089
MASTERTECH_CORS_ORIGINS=http://localhost:5173
# MASTERTECH_JWT_ISSUER=        # vacío por defecto (su JWT no lleva "iss")
# MASTERTECH_JWT_DEFAULT_ROLE=USER

# --- Citas ---
CITAS_JWT_SECRET=               # igual al secreto con que firma el backend de citas
CITAS_API_URL=http://localhost:8087
CITAS_CORS_ORIGINS=http://localhost:8087
# CITAS_JWT_ISSUER=citas-api    # por defecto citas-api
# CITAS_JWT_DEFAULT_ROLE=PACIENTE

# La autenticación y el CORS NUNCA se heredan entre proyectos: cada uno usa solo sus variables <PROYECTO>_*.

# ============ Modo clásico (un solo proyecto, rutas en la raíz /chat) ============
# Quita BOT_PROJECTS y usa BOT_PROJECT=mastertech con BOT_JWT_SECRET, BOT_JWT_ISSUER, BOT_JWT_DEFAULT_ROLE,
# BOT_CORS_ORIGINS y MASTERTECH_API_URL (como en la versión anterior).
